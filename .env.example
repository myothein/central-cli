# Nonsecret template only. Never store real access tokens/API keys in .env or Git.
CENTRAL_API_URL=https://central.example.invalid/api/v1

# Default production mode: short-lived signed OIDC/JWKS access token.
CENTRAL_AUTH_MODE=oidc
# CENTRAL_OIDC_ACCESS_TOKEN must be injected securely at runtime, not saved here.

# Local disposable QA ONLY. Legacy shared admin keys are disabled in production.
# NODE_ENV=test
# CENTRAL_AUTH_MODE=legacy
# CENTRAL_ALLOW_DEV_API_KEY=true
# CENTRAL_API_KEY must be injected securely; no value in repository.
